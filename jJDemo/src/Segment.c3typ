/**
 * A Pfizer Biopharma business segment — the top of the programme
 * structure. Three are modelled, exactly as the business reports them:
 * Primary Care (~$12B), Specialty Care (~$9B, fastest growing) and Oncology (~$5.5B).
 *
 * A {@link Segment} owns many {@link Franchise}s, each of which owns the
 * device {@link Launch}es this application governs.
 */
entity type Segment mixes SeedData {
  /** Business name of the segment, e.g. "Specialty Care". */
  name: !string

  /** Approximate annual revenue scale as the business quotes it, e.g. "~$9B". */
  revenueScale: string

  /** Year-on-year growth rate as a fraction, e.g. 0.15 for the ~15% Specialty Care figure. */
  growthRate: double

  /** The franchises that belong to this segment. Inverse of {@link Franchise#segment}. */
  franchises: [Franchise](segment)
}
