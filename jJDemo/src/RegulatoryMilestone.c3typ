/**
 * A dated regulatory milestone on a {@link Launch} — an approval or clearance
 * from an outside authority (FDA, a CHMP rapporteur, a competent authority) that
 * a launch's downstream plan is committed against. Distinct from a {@link Gate}:
 * a Gate is an internal stage-gate decision the programme owns, whereas a
 * RegulatoryMilestone is a date owned by an authority that the programme cannot
 * move — it can only react when the authority moves it.
 *
 * The anchor case is PF-07817883's US market rollout: the EU marketing
 * authorisation (MAA, EMA) is the lead train, and the FDA NDA approval is a
 * separate milestone the US launch — manufacturing build, launch stock staging,
 * field certification and commercial pre-announcement — is all committed
 * against. When the FDA slips
 * this date six weeks, {@link CascadeReplanService#cascadeReplan} fans the impact
 * out across every downstream {@link CascadeImpactItem}.
 *
 * This is an operational type (mutated at runtime by the cascade / reset), so it
 * carries no {@code SeedData} mixin and its records live in {@code data/}, which
 * loads without locking the field values against updates.
 */
entity type RegulatoryMilestone {
  /** Milestone id, e.g. "seed_milestone_pf3945_obesity_fda". */
  id: !string

  /** Display id shown on cards, e.g. "REG-PF-07817883-FDA". */
  displayId: string

  /** The launch this milestone gates. */
  launch: Launch

  /** The authority that owns the date, e.g. "FDA", "BSI", "CE (MAA (EMA))". */
  authority: !string

  /** Milestone name, e.g. "FDA NDA Clearance — US". */
  milestoneName: !string

  /**
   * The date originally committed by the authority — the plan every downstream
   * item was built against. Never moves; the slip is measured against it.
   */
  baselineDate: !datetime

  /**
   * The authority's current effective date. Equal to {@link #baselineDate} until
   * the authority moves it; {@link CascadeReplanService#cascadeReplan} sets it to
   * the new committed date and {@link CascadeReplanService#reset} restores it.
   */
  currentDate: !datetime

  /** Slip in days between {@link #currentDate} and {@link #baselineDate}. Derived and stored on replan. */
  slipDays: int

  /** Milestone state: on track, slipped (date moved, cascade not yet run) or replanned (cascade applied). */
  status: string enum('ON_TRACK', 'SLIPPED', 'REPLANNED')

  /** The downstream items that must react when this milestone moves. Inverse of {@link CascadeImpactItem#milestone}. */
  impacts: [CascadeImpactItem](milestone)
}
