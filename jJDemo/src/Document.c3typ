/**
 * A document filed for a {@link Launch}. Every launch carries a COMPLETE
 * industry-standard Pfizer Biopharma register — the full checklist is always present
 * because every item is something that must ultimately be uploaded; only the
 * {@link Document#status} varies with how far the launch has progressed. The
 * register spans nine groups (see {@link Document#group}): Development & CMC
 * (CTD), Verification & validation, Clinical & evidence, Regulatory submissions,
 * Certificates/licences/registrations, Manufacturing & quality, Labelling &
 * commercial, Supply chain & operations, and Pharmacovigilance & post-launch.
 *
 * Berobenatide keeps its bespoke, hand-authored set (78 originals plus a
 * supply-chain section); the other launches are generated deterministically by
 * {@code scripts/gen-documents.mjs}, which grades each document's status from the
 * launch's current phase against the phase the document is normally completed by
 * (a launched product reads mostly Approved; an early-phase one mostly Not
 * started). A document can evidence a {@link GateCriterion} (e.g. the PPQ
 * validation report evidences the outstanding G3 criterion).
 */
entity type Document mixes SeedData {
  /** Document name, e.g. "Development & CMC Plan". */
  name: !string

  /** Document type, e.g. "Plan", "Specification", "Validation report". */
  docType: string

  /** Group the document belongs to, e.g. "ctd", "vv", "cli", "reg". */
  group: string

  /** Revision, e.g. "rev 6". */
  revision: string

  /** Document status. Three are "missing" across the register. */
  status: string enum('ok', 'rev', 'dft', 'miss', 'na')

  /** Document date. */
  documentDate: datetime

  /** Owner, e.g. "K. Tanaka". */
  owner: string

  /** File size label, e.g. "2.4 MB". */
  fileSize: string

  /** The launch this document is filed for. */
  launch: Launch
}
