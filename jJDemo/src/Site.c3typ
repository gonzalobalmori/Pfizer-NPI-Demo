/**
 * A physical site operated by a {@link Supplier} — e.g. Siegfried Grand
 * Rapids, Vetter Ravensburg, Aptar Ferentino (IE) and Alterkülz (DE). A site holds the
 * {@link QualifiedProcess}es (such as aseptic fill-finish) that determine whether
 * it can execute a validation lot.
 */
entity type Site mixes SeedData {
  /** Site name, e.g. "Hameln". */
  name: !string

  /** Location, e.g. "Hameln, MI, US" or "Ferentino, IE". */
  location: string

  /** Capabilities summary, e.g. "aseptic fill-finish". */
  capabilities: string

  /** Date from which capacity becomes available, e.g. 29 Sep for Siegfried. */
  capacityAvailableFrom: datetime

  /** The supplier that operates this site. */
  supplier: Supplier

  /** Qualified processes at this site. Inverse of {@link QualifiedProcess#site}. */
  qualifiedProcesses: [QualifiedProcess](site)
}
